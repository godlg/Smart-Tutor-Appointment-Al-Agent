# ===== Smart Tutor Appointment AI Agent — 环境变量模板 =====
# 复制为 .env 后填入自己的值：
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env 已被 .gitignore 忽略，不要提交真实 Key。

# ---------- LLM（OpenAI 兼容格式，可换 DeepSeek / Qwen / 智谱 / OpenAI / Azure）----------
MODEL_PROVIDER=deepseek
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=your_openai_compatible_chat_base_url_here
LLM_MODEL=your_chat_model_name_here

# ---------- Embedding（可与 LLM 不同厂商）----------
# 注意：支持 openai / qwen / zhipu / doubao / openai-compatible；
# DeepSeek 没有通用 embedding API，写成 deepseek 会抛
# "Unsupported EMBEDDING_PROVIDER" → RAG 检索与长期记忆召回静默降级为空。
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=your_openai_compatible_embedding_base_url_here
EMBEDDING_MODEL=your_embedding_model_name_here

# 本机 Ollama 示例（离线、零成本、无需真 key；先 `ollama pull qwen3-embedding:0.6b`）：
#   EMBEDDING_PROVIDER=openai-compatible
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#   EMBEDDING_MODEL=qwen3-embedding:0.6b      # 1024 维
# ⚠ 换 embedding 模型后**必须**重算存量向量：
#   ./.venv/Scripts/python.exe scripts/rebuild_knowledge_embeddings.py
#   旧向量与新 query 不在同一向量空间、维度还常常不同（如 doubao 2048 → 本机 1024），
#   不重算会让 FAISS 维度不匹配 → dense 路失效（检索静默降级为 BM25 单路）。

# ---------- 数据库 ----------
# ⚠ 本变量目前**只被 config/database.py 的 db_config 读取，而全仓无人使用该对象**：
#   DatabaseRouter/SessionManager 的库路径是硬编码默认值 `sqlite:///data/smart_appointment.db`，
#   调用方几乎都写 `DatabaseRouter()`（不带参）→ 改本变量**不会**让服务换库。
#   要指向别的库，只能改 `db/db_router.py:25` 的默认值（或给调用方传参）。
DATABASE_URL=sqlite:///./data/smart_appointment.db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- 检索（混合检索）----------
RETRIEVAL_MODE=hybrid     # dense 单路 FAISS / hybrid 双路 + RRF + 精排（默认 hybrid）
RERANK_ENABLED=true       # 精排模型缺失或失败时自动回退 RRF
RRF_K=60
RRF_CANDIDATES=20
# RAG_MIN_RERANK_SCORE=0.0 # 精排相关性阈值，**默认关闭（不设阈值，不过滤）**。
                          # 只在精排真的跑过时生效，RRF 兜底路径不应用。
                          # 开启需按目标模型量纲校准：bge 的 logit 随 query 口语化
                          # 程度整体下移，0.0 不是中性分界 —— 实测 24 条口语化 query
                          # 里 12 条的正确答案精排分为负（多为排名第 1），设 0.0 会把
                          # recall@3 从 0.9167 打到 0.5000。不填该变量即不设阈值。
RERANK_MAX_LENGTH=512     # 精排 tokenizer 截断长度（默认 512）
                          # 中文 ~1 字 ≈ 1 token，需 >= CHUNK_SIZE 否则块尾进不了精排视野

# ---------- 检索前的 query 变换（多查询召回 + RRF 融合）----------
QUERY_TRANSFORM=rule            # off 不变换 / rule 规则变换（默认，零 LLM 成本）/ llm 额外调一次小 LLM 改写
                                # 非法值回退 rule。原始 query 恒排第 0 位且必须被检索，变换只增量提高召回。
QUERY_TRANSFORM_TIMEOUT=3.0     # llm 档超时秒数（默认 3.0）；超时/异常/解析失败一律回退 rule 结果
QUERY_TRANSFORM_MAX_VARIANTS=3  # 变体数上限（默认 3，含原始 query）

# ---------- 分块（须与 config/components.yaml 的 splitter 参数一致，有测试守卫）----------
CHUNK_SIZE=500            # 单块字符数（默认 500）；500 中文字 ≈ 500 token < RERANK_MAX_LENGTH
CHUNK_OVERLAP=50          # 相邻块重叠字符数（默认 50）

# ---------- 人工接管 ----------
HANDOFF_THRESHOLD=3                    # 同一会话连续踢回多少次自动转人工
TUTOR_IDENTITY_COOKIE_SECURE=false     # HTTPS 终止代理后方设为 true

# ---------- 编排（可选）----------
ORCHESTRATOR=legacy       # legacy 自研状态机（默认）/ graph LangGraph 图编排
GRAPH_PERSISTENCE=0       # 1 = 图编排用 SqliteSaver 持久化 checkpoint

# ---------- 运行 ----------
DEBUG=True
LOG_LEVEL=INFO
